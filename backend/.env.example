# AI-Livestock Health Sentinel - Environment Variables Template
PROJECT_NAME="AI-Livestock Health Sentinel"
VERSION="2.0.0"
ENVIRONMENT="development"
DEBUG=True

# Server
HOST="127.0.0.1"
PORT=8000

# Security
SECRET_KEY="replace_with_a_secure_secret_key_in_production"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=120

# Database
DATABASE_URL="postgresql+psycopg2://postgres:postgres@localhost:5432/livestock_sentinel"
POSTGRES_USER="postgres"
POSTGRES_PASSWORD="postgres"
POSTGRES_HOST="localhost"
POSTGRES_PORT=5432
POSTGRES_DB="livestock_sentinel"

# Multi-Modal Health Risk Engine Configurable Weights (Must sum to ~1.0)
RISK_WEIGHT_IMAGE=0.40
RISK_WEIGHT_SYMPTOM=0.35
RISK_WEIGHT_ENVIRONMENT=0.15
RISK_WEIGHT_CONTEXT=0.10

# Spatio-Temporal Disease Cluster Detection Configuration
CLUSTER_GEO_RADIUS_KM=5.0
CLUSTER_MIN_REPORTS=3
CLUSTER_TIME_WINDOW_DAYS=14
CLUSTER_MIN_RISK_SCORE=60.0

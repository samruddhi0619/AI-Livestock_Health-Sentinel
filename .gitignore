# ==========================================================
# AI-Livestock Health Sentinel - Git Ignore Rules
# ==========================================================

# 1. Python & Bytecode
__pycache__/
*.py[cod]
*$py.class
*.so
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
share/python-wheels/
*.egg-info/
.installed.cfg
*.egg
MANIFEST
.pytest_cache/
.coverage
htmlcov/
.mypy_cache/

# 2. Virtual Environments
venv/
env/
ENV/
env.bak/
venv.bak/
.venv/

# 3. Environment Variables & Secrets
.env
.env.local
.env.*.local
*.env
*.pem
*.key

# 4. Node.js & Frontend Build
frontend/node_modules/
node_modules/
frontend/dist/
dist/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.vite/
frontend/.vite/

# 5. Machine Learning & Model Checkpoints
# Model weights should be tracked via Git LFS if versioned
*.pkl
*.pt
*.pth
*.onnx
*.bin
*.h5
*.joblib
ml/models/*.pkl
!ml/models/.gitkeep

# 6. Large Datasets & Raw Data
# Use Git LFS or external object storage (S3/GCS) for large training data
datasets/raw/
datasets/processed/
datasets/*.tar.gz
datasets/*.zip
datasets/*.parquet
# Ignore generated large datasets, but keep sample schema
datasets/large_*.csv

# 7. Uploads & Temporary Media
uploads/*
!uploads/.gitkeep

# 8. Local Sandbox Runtime Database Backups
backend/data/*.bak
backend/data/*_backup.json

# 9. Operating System & IDE Caches
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
.vscode/
.idea/
*.sublime-project
*.sublime-workspace
*.swp
*.swo
*~

# AI-Livestock Health Sentinel Environment Variables

PROJECT_NAME="AI-Livestock Health Sentinel"
ENVIRONMENT="development"
DEBUG=true

# Server Configuration
HOST=127.0.0.1
PORT=8000

# Security
SECRET_KEY="your-secure-random-secret-key-change-in-production"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=120

# PostgreSQL Connection
DATABASE_URL="postgresql+psycopg2://postgres:postgres@localhost:5432/livestock_sentinel"
POSTGRES_USER="postgres"
POSTGRES_PASSWORD="postgres"
POSTGRES_HOST="localhost"
POSTGRES_PORT=5432
POSTGRES_DB="livestock_sentinel"

# Connection Pooling
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20
DB_POOL_TIMEOUT=30

# CORS Allowed Origins (Comma-separated)
CORS_ORIGINS="http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000"

# Multi-Modal Risk Engine Weight Configuration (Must sum to 1.0)
RISK_WEIGHT_IMAGE=0.40
RISK_WEIGHT_SYMPTOM=0.35
RISK_WEIGHT_ENVIRONMENT=0.15
RISK_WEIGHT_CONTEXT=0.10
